rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Protected password-hash records for phone+password accounts.
    // The Admin SDK writes/reads these (bypassing rules); ALL direct frontend
    // read/write access is denied — this block makes the denial explicit and
    // self-documenting in addition to the Global Safety Net above.
    match /_authRecords/{recordId} {
      allow read, write: if false;
    }

    // --- Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    
    function isValidUser(data) {
      return data.get('uid', request.auth.uid) is string
        && data.get('name', 'User') is string
        && (data.get('uniqueCode', null) == null || data.get('uniqueCode', '') is string)
        && (data.get('isOnline', null) == null || data.get('isOnline', false) is bool)
        && (data.get('avatarUrl', null) == null || data.get('avatarUrl', '') is string)
        && (data.get('phone', null) == null || data.get('phone', '') is string)
        && (data.get('currentRoomId', null) == null || data.get('currentRoomId', '') is string)
        && (data.get('isMuted', null) == null || data.get('isMuted', false) is bool)
        && (data.get('isKicked', null) == null || data.get('isKicked', false) is bool)
        && (data.get('lastActive', null) == null || data.get('lastActive', request.time) is timestamp)
        && (data.get('createdAt', null) == null || data.get('createdAt', '') is string || data.get('createdAt', request.time) is timestamp);
    }

    function isValidSyncGroup(data) {
      return (data.get('id', '') is string)
        && data.get('name', '') is string
        && (data.get('creatorId', '') is string)
        && (data.get('memberIds', null) == null || data.get('memberIds', []) is list)
        && (data.get('playback', null) == null || data.get('playback', {}) is map)
        && (data.get('videoData', null) == null || data.get('videoData', {}) is map)
        && (data.get('activeSubtitles', null) == null || data.get('activeSubtitles', []) is list)
        && (data.get('currentMovieId', null) == null || data.get('currentMovieId', '') is string)
        && (data.get('playlist', null) == null || data.get('playlist', []) is list)
        && (data.get('currentPlaylistIndex', null) == null || data.get('currentPlaylistIndex', 0) is int)
        && (data.get('autoLoop', null) == null || data.get('autoLoop', false) is bool)
        && (data.get('createdAt', null) == null || data.get('createdAt', '') is string || data.get('createdAt', request.time) is timestamp);
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'rebarsarkawt91@gmail.com' && request.auth.token.email == 'rebarsarkawt91@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['owner', 'admin', 'super_admin', 'Admin', 'super-admin'])
      );
    }

    function isStaff() {
      return isAdmin();
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.senderName is string
        && (data.text == null || (data.text is string && data.text.size() <= 2000))
        && (data.audio == null || (data.audio is string && data.audio.size() <= 2000000)) // 2MB base64 limit
        && data.type in ['text', 'voice']
        && (data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidReaction(data) {
      return data.senderId == request.auth.uid
        && data.type is string && data.type.size() <= 10
        && (data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidMovie(data) {
      return data.id is string
        && data.title is string && data.title.size() <= 500
        && data.image is string && data.image.size() <= 500000 // Increased size limit
        && (data.get('embedUrl', null) == null || (data.embedUrl is string && data.embedUrl.size() <= 2000))
        && (data.get('trailerUrl', null) == null || (data.trailerUrl is string && data.trailerUrl.size() <= 2000))
        && (data.get('streamingUrl', null) == null || (data.streamingUrl is string && data.streamingUrl.size() <= 2000))
        && (data.get('external_link', null) == null || (data.external_link is string && data.external_link.size() <= 2000))
        && (data.get('externalMovieLink', null) == null || (data.externalMovieLink is string && data.externalMovieLink.size() <= 2000))
        && (data.get('isYouTube', null) == null || data.isYouTube is bool)
        && (data.get('quality', null) == null || data.quality is string)
        && (data.get('date', null) == null || data.date is string || data.date is timestamp)
        && (data.get('isNetflixOriginal', null) == null || data.isNetflixOriginal is bool)
        && (data.get('tags', null) == null || data.tags is list)
        && (data.get('category', null) == null || data.category is string)
        && (data.get('type', null) == null || data.type in ['movie', 'tv'])
        && (data.get('rating', null) == null || data.rating is string)
        && (data.get('year', null) == null || data.year is string)
        && (data.get('whatsappLink', null) == null || data.whatsappLink is string);
    }

    // --- Config Collection ---
    match /config/{configId} {
      allow read, write: if true;
    }

    // --- Movies Collection ---
    // Public read + validated public writes (same rationale as genres): the
    // admin login is localStorage-based and anonymous Firebase Auth is DISABLED
    // on this project, so isAdmin()/isSignedIn() gates DENY every client-side
    // write with "Missing or insufficient permissions". isValidMovie keeps the
    // catalog shape sane while guaranteeing posted movies persist as the durable
    // Firestore backup and deletes from the "سەرپەرشتی فیلمەکان" panel remove
    // the document permanently. The delete guard mirrors genres ('_meta' only):
    // it must NOT read resource.data — a deleted/non-backed-up movie doc has a
    // null resource, and touching resource.data there throws and DENIES the
    // delete with "Missing or insufficient permissions". '_meta' is the single
    // reserved id we keep protected.
    match /movies/{movieId} {
      allow read: if true;
      allow create, update: if isValidMovie(incoming());
      allow delete: if movieId != '_meta';
    }

    // --- Genres Collection (dynamic پۆلێنەکان) ---
    // Public read so the main nav renders live. Writes are validated public
    // (same pattern as config/users/system_check below): the admin login is
    // localStorage-based and anonymous Firebase Auth is DISABLED on this project,
    // so any request.auth gate (isSignedIn/isAdmin) would DENY every genre write
    // with "Missing or insufficient permissions". isValidGenre + the _meta guard
    // keep the catalog sane while guaranteeing adds like "kurdi" save instantly.
    function isValidGenre(data) {
      return data.get('name', '') is string
        && data.get('name', '').size() > 0 && data.get('name', '').size() <= 50
        && data.get('tag', '') is string
        && data.get('tag', '').size() > 0 && data.get('tag', '').size() <= 50
        && data.get('sortOrder', 0) is int
        && data.get('sortOrder', 0) >= 0
        && (data.get('createdAt', null) == null || data.get('createdAt', null) is timestamp);
    }

    match /genres/{genreId} {
      allow read: if true;
      allow create, update: if isValidGenre(incoming());
      allow delete: if genreId != '_meta';
    }

    // --- System Check Collection ---
    match /system_check/{docId} {
      allow read, write: if true;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow read, write: if true;
    }

    // --- Sync Groups Collection ---
    match /syncGroups/{groupId} {
      function getGroupData() {
        return get(/databases/$(database)/documents/syncGroups/$(groupId)).data;
      }

      function isMemberOf(data) {
        return isSignedIn() && data != null && data.get('memberIds', []).hasAny([request.auth.uid]);
      }

      function isGlobalRoom() {
        return groupId == 'global_room_official';
      }

      allow get: if true;
      allow list: if (isSignedIn() && (isMemberOf(resource.data) || resource.id == 'global_room_official' || isAdmin()) || resource.id == 'global_room_official') && request.query.limit <= 25;
      
      allow create: if isSignedIn() && isValidSyncGroup(incoming()) && (
        (incoming().get('creatorId', '') == request.auth.uid && groupId == request.auth.uid) || // Personal rooms
        (incoming().get('creatorId', '') == request.auth.uid) || // Custom rooms
        (isGlobalRoom() && incoming().get('creatorId', '') == 'system')
      );

      allow update: if isSignedIn() && (
        // Action: Admin/Creator Full Update
        ((existing().get('creatorId', '') == request.auth.uid || isAdmin()) && isValidSyncGroup(incoming()) && 
         incoming().diff(existing()).affectedKeys().hasOnly(['id', 'name', 'currentMovieId', 'playback', 'memberIds', 'videoData', 'activeSubtitles', 'updatedAt', 'playlist', 'currentPlaylistIndex', 'autoLoop', 'isOnline'])) ||
        
        // Action: Join (Add oneself to an existing room)
        (!isMemberOf(existing()) && 
         incoming().get('memberIds', []).hasAll(existing().get('memberIds', [])) && 
         request.auth.uid in incoming().get('memberIds', []) && 
         incoming().get('memberIds', []).size() == existing().get('memberIds', []).size() + 1 &&
         incoming().diff(existing()).affectedKeys().hasOnly(['memberIds'])) ||
        
        // Action: Sync Playback (Any member can sync)
        (isMemberOf(existing()) && isValidSyncGroup(incoming()) &&
         incoming().diff(existing()).affectedKeys().hasOnly(['playback'])) ||
        
        // Global Room sync (Admins or System actions)
        (isGlobalRoom() && isSignedIn() && (isAdmin() ||
         incoming().diff(existing()).affectedKeys().hasOnly(['playback', 'currentMovieId', 'memberIds', 'videoData', 'activeSubtitles', 'updatedAt', 'playlist', 'currentPlaylistIndex', 'autoLoop', 'isOnline'])))
      );
      
      allow delete: if isSignedIn() && resource.data.get('creatorId', '') == request.auth.uid;

      // --- Nested Messages ---
      match /messages/{messageId} {
        allow get: if isGlobalRoom() || (isSignedIn() && isMemberOf(getGroupData()));
        allow list: if (isGlobalRoom() || (isSignedIn() && isMemberOf(getGroupData()))) && request.query.limit <= 100;
        allow create: if isSignedIn() && (isGlobalRoom() || isMemberOf(getGroupData()))
          && isValidMessage(incoming());
      }

      // --- Nested Reactions ---
      match /reactions/{reactionId} {
        allow get: if isGlobalRoom() || (isSignedIn() && isMemberOf(getGroupData()));
        allow list: if (isGlobalRoom() || (isSignedIn() && isMemberOf(getGroupData()))) && request.query.limit <= 50;
        allow create: if isSignedIn() && (isGlobalRoom() || isMemberOf(getGroupData()))
          && isValidReaction(incoming());
      }
    }

    // --- VIP Module 14 Collections (vip_tickets / vip_videos / vip_rooms / vip_requests / vip_settings) ---
    // Dedicated Firestore schema for the VIP ticketing & broadcast system.
    // Anonymous Firebase Auth is DISABLED on this project, so isAdmin()/isSignedIn()
    // gates would DENY every client write; instead we use validated public writes
    // (same pattern as genres/config/users). This keeps the admin side panel and
    // the user modal fully real-time and guarantees VIP data never crosses into
    // the regular movies catalog (zero cross-contamination).

    function isValidVipTicket(data) {
      return data.get('code', '') is string
        && data.get('code', '').size() > 0 && data.get('code', '').size() <= 64
        && data.get('customerName', '') is string
        && data.get('customerName', '').size() > 0 && data.get('customerName', '').size() <= 200
        && data.get('customerPhone', '') is string
        && data.get('customerPhone', '').size() > 0 && data.get('customerPhone', '').size() <= 40
        && (data.get('videoUrl', null) == null || data.videoUrl is string)
        && (data.get('vipVideoId', null) == null || data.vipVideoId is string)
        && data.get('usedCount', 0) is int && data.get('usedCount', 0) >= 0 && data.get('usedCount', 0) <= 2
        && (data.get('lastIp', null) == null || data.lastIp is string)
        && (data.get('lastDevice', null) == null || data.lastDevice is string)
        && data.get('status', 'active') in ['active', 'used', 'Expired']
        && (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidVipVideo(data) {
      return data.get('title', '') is string
        && data.get('title', '').size() > 0 && data.get('title', '').size() <= 200
        && data.get('videoUrl', '') is string
        && data.get('videoUrl', '').size() > 0 && data.get('videoUrl', '').size() <= 2000
        && (data.get('trailerUrl', null) == null || (data.trailerUrl is string && data.trailerUrl.size() <= 2000))
        && (data.get('image', null) == null || data.image is string)
        && data.get('sortOrder', 0) is int && data.get('sortOrder', 0) >= 0
        && (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidVipRequest(data) {
      return data.get('customerName', '') is string
        && data.get('customerName', '').size() > 0 && data.get('customerName', '').size() <= 200
        && data.get('customerPhone', '') is string
        && data.get('customerPhone', '').size() > 0 && data.get('customerPhone', '').size() <= 40
        && (data.get('bankScreenshot', null) == null || data.bankScreenshot is string)
        && data.get('status', 'Pending') is string
        && (data.get('approvedCode', null) == null || data.approvedCode is string)
        && (data.get('videoUrl', null) == null || data.videoUrl is string)
        && (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidVipMessage(data) {
      return data.senderId is string
        && data.senderName is string
        && (data.text == null || (data.text is string && data.text.size() <= 2000))
        && (data.audio == null || (data.audio is string && data.audio.size() <= 2000000))
        && data.type in ['text', 'voice']
        && (data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidReactionPublic(data) {
      return data.senderId is string
        && data.type is string && data.type.size() <= 10
        && (data.createdAt == null || data.createdAt is timestamp);
    }

    match /vip_tickets/{ticketCode} {
      allow read: if true;
      allow create, update: if isValidVipTicket(incoming());
      allow delete: if ticketCode != '_meta';
    }

    match /vip_videos/{videoId} {
      allow read: if true;
      allow create, update: if isValidVipVideo(incoming());
      allow delete: if videoId != '_meta';
    }

    match /vip_requests/{requestId} {
      allow read: if true;
      allow create, update: if isValidVipRequest(incoming());
      allow delete: if requestId != '_meta';
    }

    match /vip_settings/{settingId} {
      allow read, write: if true;
    }

    // VIP rooms live in their own collection (never in syncGroups) so the VIP
    // lounge playback never leaks into the regular sync room list.
    match /vip_rooms/{roomId} {
      allow read: if true;
      allow create, update: if isValidSyncGroup(incoming()) && incoming().get('isVIP', false) == true;
      allow delete: if roomId != '_meta';

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidVipMessage(incoming());
      }

      match /reactions/{reactionId} {
        allow read: if true;
        allow create: if isValidReactionPublic(incoming());
      }
    }

    // --- Cinema Window Rooms Collection ---
    // Dedicated collection for Cinema Window room configurations.
    // Visitors can view muted previews; full access requires valid access codes.
    match /cinemaWindows/{cinemaWindowId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && cinemaWindowId != '_meta';
    }

    // --- Access Codes Collection ---
    // Secure access codes generated after successful payment.
    // Each code grants access to one specific Cinema Window room.
    match /accessCodes/{accessCodeId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && accessCodeId != '_meta';
    }

    // --- Payment Records Collection ---
    // Payment records linked to Cinema Window access.
    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if isAdmin() && paymentId != '_meta';
    }

    // --- Room Viewers Collection ---
    // Track current viewers of Cinema Window rooms.
    match /roomViewers/{viewerId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- Room Events Collection ---
    // Log events for Cinema Window rooms (viewing, access, etc.).
    match /roomEvents/{eventId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }

    // --- Invitations Collection ---
    match /invitations/{inviteId} {
      allow read, write: if true;
    }

    // --- Module 8 Security Panel Collections (admin_security_users / user_activity_logs / banned_ips) ---
    // Dedicated, isolated Firestore schema for the "بەکارهێنەران و مافەکان" panel.
    // User sessions, IPs, locations, roles and security logs live here — never in
    // the app `users` collection — so tracking data has zero cross-contamination.
    // Anonymous Firebase Auth is DISABLED on this project, so isAdmin()/isSignedIn()
    // gates would DENY every client write; validated public writes are used instead
    // (same pattern as genres/config/users/VIP collections).

    function isValidSecurityUser(data) {
      return data.get('uid', '') is string
        && data.get('uid', '').size() > 0 && data.get('uid', '').size() <= 128
        && data.get('name', '') is string
        && (data.get('phone', null) == null || data.phone is string)
        && (data.get('uniqueCode', null) == null || data.uniqueCode is string)
        && (data.get('residence', null) == null || data.residence is string)
        && (data.get('country', null) == null || data.country is string)
        && (data.get('role', null) == null || data.role is string)
        && (data.get('deviceIp', null) == null || (data.deviceIp is string && data.deviceIp.size() <= 64))
        && (data.get('isOnline', null) == null || data.isOnline is bool)
        && (data.get('status', 'active') in ['active', 'banned', 'kicked'])
        && (data.get('loginCount', 0) is int && data.get('loginCount', 0) >= 0)
        && (data.get('firstSeen', null) == null || data.firstSeen is string || data.firstSeen is timestamp)
        && (data.get('lastLoginAt', null) == null || data.lastLoginAt is string || data.lastLoginAt is timestamp)
        && (data.get('lastActive', null) == null || data.lastActive is string || data.lastActive is timestamp);
    }

    function isValidActivityLog(data) {
      return data.get('uid', '') is string
        && data.get('uid', '').size() > 0 && data.get('uid', '').size() <= 128
        && data.get('action', '') is string
        && data.get('action', '').size() > 0 && data.get('action', '').size() <= 100
        && (data.get('name', null) == null || data.name is string)
        && (data.get('uniqueCode', null) == null || data.uniqueCode is string)
        && (data.get('detail', null) == null || (data.detail is string && data.detail.size() <= 2000))
        && (data.get('role', null) == null || data.role is string)
        && (data.get('deviceIp', null) == null || data.deviceIp is string)
        && (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp);
    }

    function isValidBannedIp(data) {
      return data.get('ip', '') is string
        && data.get('ip', '').size() > 0 && data.get('ip', '').size() <= 64
        && (data.get('reason', null) == null || data.reason is string)
        && (data.get('bannedBy', null) == null || data.bannedBy is string)
        && (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp);
    }

    match /admin_security_users/{userId} {
      allow read: if true;
      allow create, update: if isValidSecurityUser(incoming());
      allow delete: if userId != '_meta';
    }

    match /user_activity_logs/{logId} {
      allow read: if true;
      allow create, update: if isValidActivityLog(incoming());
      allow delete: if logId != '_meta';
    }

    match /banned_ips/{ipId} {
      allow read: if true;
      allow create, update: if isValidBannedIp(incoming());
      allow delete: if ipId != '_meta';
    }

    // --- Module 9 Channel & Brand Settings (channel_settings) ---
    // Dedicated collection persisting the 4 social/brand URLs (YouTube,
    // TikTok, Instagram, Facebook). Validated public writes keep the admin
    // save button working without Firebase Auth (anonymous auth is disabled
    // on this project, same pattern as genres/config); the whole app reads
    // the doc via onSnapshot for real-time sync.
    function isValidChannelSettings(data) {
      return data.get('youtubeUrl', '') is string && data.get('youtubeUrl', '').size() <= 500
        && data.get('tiktokUrl', '') is string && data.get('tiktokUrl', '').size() <= 500
        && data.get('instagramUrl', '') is string && data.get('instagramUrl', '').size() <= 500
        && data.get('facebookUrl', '') is string && data.get('facebookUrl', '').size() <= 500
        && (data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp)
        && (data.get('updatedBy', null) == null || data.updatedBy is string);
    }

    match /channel_settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidChannelSettings(incoming());
      allow delete: if settingId != '_meta';
    }

    // --- Module 19 Main Broadcast (main_broadcast_room / broadcast_settings) ---
    // Dedicated, isolated Firestore schema for the پەخشی گشتی public broadcast.
    // main_broadcast_room/state holds the live stream URL + pause/resume/seek
    // state, its /messages subcollection holds the public live chat, and
    // broadcast_settings/default holds preview/title settings. Zero overlap
    // with VIP rooms, syncGroups or config so nothing cross-contaminates.
    // Validated public writes (anonymous auth disabled on this project, same
    // pattern as genres/config/channel_settings).

    function isValidBroadcastState(data) {
      return (data.get('currentMovieUrl', '') is string && data.get('currentMovieUrl', '').size() <= 2000)
        && data.get('isPlaying', false) is bool
        && (data.get('currentTime', 0) is int || data.get('currentTime', 0) is float)
        && data.get('currentTime', 0) >= 0
        && (data.get('name', null) == null || data.name is string)
        && (data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp)
        && (data.get('updatedBy', null) == null || data.updatedBy is string);
    }

    function isValidBroadcastMessage(data) {
      return data.get('sender', '') is string
        && data.get('senderCode', '') is string
        && data.get('text', '') is string && data.get('text', '').size() <= 2000
        && (data.get('timestamp', null) == null || data.timestamp is string || data.timestamp is timestamp)
        && (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    function isValidBroadcastSettings(data) {
      return (data.get('previewEnabled', null) == null || data.previewEnabled is bool)
        && (data.get('previewAutoplay', null) == null || data.previewAutoplay is bool)
        && (data.get('broadcastTitle', null) == null || (data.broadcastTitle is string && data.broadcastTitle.size() <= 200))
        && (data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp)
        && (data.get('updatedBy', null) == null || data.updatedBy is string);
    }

    match /main_broadcast_room/{docId} {
      allow read: if true;
      allow create, update: if isValidBroadcastState(incoming());
      allow delete: if docId != '_meta';

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidBroadcastMessage(incoming());
        allow update, delete: if false;
      }
    }

    match /broadcast_settings/{settingId} {
      allow read: if true;
      allow create, update: if isValidBroadcastSettings(incoming());
      allow delete: if settingId != '_meta';
    }

    // --- Permanent CinemaChat Two-Person Watch Room (cinemaChatRoom) ---
    // Dedicated, isolated Firestore schema for the permanent "CinemaChat" room
    // (main_broadcast_room): the state doc holds the session, pairing, mutual
    // approvals and the playback source of truth; its /messages subcollection
    // holds the realtime chat. Zero overlap with syncGroups, VIP, friends_rooms
    // or the main broadcast. Anonymous Firebase Auth is DISABLED on this project,
    // so writes are validated public writes (same pattern as genres/config/VIP).
    // Security is still enforced structurally: ONLY a registered session
    // participant (host or guest, matched by id) may mutate the state doc, and a
    // guest may only join by adding themselves (never by touching another
    // participant or playback). Chat messages are immutable.
    function isValidCinemaChatParticipant(p) {
      return p.get('id', '') is string && p.get('id', '').size() > 0 && p.get('id', '').size() <= 128
        && p.get('name', '') is string && p.get('name', '').size() > 0 && p.get('name', '').size() <= 200
        && p.get('code', '') is string && p.get('code', '').size() > 0 && p.get('code', '').size() <= 64
        && (p.get('avatarUrl', null) == null || p.get('avatarUrl', '') is string);
    }

    function isValidCinemaChatMovieData(m) {
      return m.get('id', '') is string && m.get('id', '').size() > 0 && m.get('id', '').size() <= 128
        && m.get('title', '') is string && m.get('title', '').size() > 0 && m.get('title', '').size() <= 500
        && (m.get('image', null) == null || (m.get('image', '') is string && m.get('image', '').size() <= 500000))
        && (m.get('embedUrl', null) == null || m.get('embedUrl', '') is string)
        && (m.get('videoUrl', null) == null || m.get('videoUrl', '') is string)
        && (m.get('hdtodayUrl', null) == null || m.get('hdtodayUrl', '') is string)
        && (m.get('vidsrcUrl', null) == null || m.get('vidsrcUrl', '') is string)
        && (m.get('vidmolyUrl', null) == null || m.get('vidmolyUrl', '') is string)
        && (m.get('streamwishUrl', null) == null || m.get('streamwishUrl', '') is string)
        && (m.get('fileLrunUrl', null) == null || m.get('fileLrunUrl', '') is string)
        && (m.get('youtubeMovieUrl', null) == null || m.get('youtubeMovieUrl', '') is string)
        && (m.get('otherVideoUrl', null) == null || m.get('otherVideoUrl', '') is string)
        && (m.get('streamingUrl', null) == null || m.get('streamingUrl', '') is string)
        && (m.get('external_link', null) == null || m.get('external_link', '') is string)
        && (m.get('externalMovieLink', null) == null || m.get('externalMovieLink', '') is string)
        && (m.get('isYouTube', null) == null || m.isYouTube is bool)
        && (m.get('videoId', null) == null || m.videoId is string)
        && (m.get('duration', null) == null || m.duration is int || m.duration is float);
    }

    function isValidCinemaChatPlayback(pb) {
      return (pb.get('movieData', null) == null || isValidCinemaChatMovieData(pb.get('movieData', {})))
        && (pb.get('movieId', null) == null || pb.get('movieId', '') is string)
        && pb.get('isPlaying', false) is bool
        && (pb.get('currentTime', 0) is int || pb.get('currentTime', 0) is float)
        && pb.get('currentTime', 0) >= 0
        && (pb.get('updatedAt', 0) is int || pb.get('updatedAt', 0) is float)
        && (pb.get('updatedBy', null) == null || pb.get('updatedBy', '') is string);
    }

    function isValidCinemaChatProposal(prop) {
      return (prop.get('movieData', null) == null || isValidCinemaChatMovieData(prop.get('movieData', {})))
        && prop.get('hostApproved', false) is bool
        && prop.get('guestApproved', false) is bool
        && (prop.get('proposedBy', null) == null || prop.get('proposedBy', '') is string);
    }

    function isValidCinemaChatState(data) {
      return data.get('roomId', '') == 'main_broadcast_room'
        && data.get('name', '') is string && data.get('name', '').size() > 0 && data.get('name', '').size() <= 200
        && data.get('isOfficial', false) is bool
        && (data.get('sessionId', null) == null || data.get('sessionId', '') is string)
        && data.get('sessionState', '') in ['EMPTY','WAITING_FOR_PARTNER','PAIRING','WAITING_FOR_APPROVAL','READY','PLAYING','PAUSED','DISCONNECTED','ENDED']
        && (data.get('host', null) == null || isValidCinemaChatParticipant(data.get('host', {})))
        && (data.get('guest', null) == null || isValidCinemaChatParticipant(data.get('guest', {})))
        && data.get('hostApproved', false) is bool
        && data.get('guestApproved', false) is bool
        && (data.get('joinCode', null) == null || (data.get('joinCode', '') is string && data.get('joinCode', '').size() <= 32))
        && (data.get('movieProposal', null) == null || isValidCinemaChatProposal(data.get('movieProposal', {})))
        && (data.get('playback', null) == null || isValidCinemaChatPlayback(data.get('playback', {})))
        && (data.get('hostLastSeen', null) == null || data.get('hostLastSeen', 0) is int || data.get('hostLastSeen', 0) is float)
        && (data.get('guestLastSeen', null) == null || data.get('guestLastSeen', 0) is int || data.get('guestLastSeen', 0) is float)
        && (data.get('updatedAt', 0) is int || data.get('updatedAt', 0) is float)
        && (data.get('updatedBy', null) == null || data.get('updatedBy', '') is string);
    }

    function isValidCinemaChatMessage(data) {
      let kind = data.get('kind', 'text');
      return kind in ['text', 'voice']
        && data.get('senderId', '') is string && data.get('senderId', '').size() > 0 && data.get('senderId', '').size() <= 128
        && data.get('senderName', '') is string && data.get('senderName', '').size() > 0 && data.get('senderName', '').size() <= 200
        && data.get('senderCode', '') is string && data.get('senderCode', '').size() > 0 && data.get('senderCode', '').size() <= 64
        && data.get('text', '') is string && data.get('text', '').size() <= 2000
        && (kind == 'text' ? data.get('text', '').size() > 0 : data.get('text', '') == '')
        && (data.get('voiceDataUrl', null) == null || (data.get('voiceDataUrl', '') is string && data.get('voiceDataUrl', '').size() > 0 && data.get('voiceDataUrl', '').size() <= 1200000))
        && (data.get('duration', null) == null || data.get('duration', 0) is int || data.get('duration', 0) is float)
        && (data.get('timestamp', null) == null || data.get('timestamp', '') is string)
        && (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    // Safe participant-id lookup. The host/guest fields may be ABSENT or NULL
    // (e.g. a session with no guest yet), and Firestore rules throw a null
    // value error when .get() is called on a null value — so resolve to ''.
    function cinemaChatParticipantId(p) {
      return p == null ? '' : p.get('id', '');
    }

    // The actor of any state mutation (from the incoming doc's updatedBy) must be
    // one of the two registered session participants.
    function isCinemaChatActor(incoming) {
      // roomId is not in scope here (this function is declared above the
      // match /cinemaChatRoom/{roomId} block), so use the fixed room id.
      let current = get(/databases/$(database)/documents/cinemaChatRoom/main_broadcast_room).data;
      return incoming.get('updatedBy', '') in [
        cinemaChatParticipantId(current.get('host', null)),
        cinemaChatParticipantId(current.get('guest', null))
      ];
    }

    // A stranger may only JOIN an existing session by adding themselves as the
    // guest; nothing else may change in the same write (no playback/approvals),
    // and there must be no guest already seated (strict two-person room).
    function isCinemaChatJoin(incoming) {
      // roomId is not in scope here (function is above the match block), so use
      // the fixed room id.
      let current = get(/databases/$(database)/documents/cinemaChatRoom/main_broadcast_room).data;
      let me = incoming.get('updatedBy', '');
      return me == cinemaChatParticipantId(incoming.get('guest', null))
        && current.get('host', {}).get('id', '') != me
        && current.get('guest', null) == null
        && current.get('sessionState', '') in ['WAITING_FOR_PARTNER','PAIRING','WAITING_FOR_APPROVAL','READY','PLAYING','PAUSED','DISCONNECTED']
        && incoming.diff(current).affectedKeys().hasOnly(['guest','sessionState','joinCode','guestApproved','hostApproved','guestLastSeen','updatedAt','updatedBy']);
    }

    match /cinemaChatRoom/{roomId} {
      allow read: if true;
      allow create: if roomId == 'main_broadcast_room'
        && isValidCinemaChatState(incoming())
        && incoming().get('updatedBy', '') in [
          cinemaChatParticipantId(incoming().get('host', null)),
          cinemaChatParticipantId(incoming().get('guest', null))
        ];
      allow update: if roomId == 'main_broadcast_room'
        && isValidCinemaChatState(incoming())
        && (isCinemaChatActor(incoming()) || isCinemaChatJoin(incoming()));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidCinemaChatMessage(incoming());
        allow update, delete: if false;
      }
    }

    // --- Friends Room (ژوورەکانی هاوڕێیان) ---
    // Dedicated, isolated Firestore schema for the "Came Here Rooms" module.
    // friends_rooms/{roomId} holds the room (name, host code, generated unique
    // join code, category/genre filters, current movie + play/seek state, joined
    // members); its /messages subcollection holds the per-room live chat. Zero
    // overlap with VIP rooms, syncGroups, the main broadcast or config. Validated
    // public writes (anonymous Firebase Auth is DISABLED on this project, same
    // pattern as genres/config/VIP/main_broadcast). Chat messages are immutable.

    function isValidFriendsRoom(data) {
      return (data.get('id', '') is string && data.get('id', '').size() <= 128)
        && (data.get('name', '') is string && data.get('name', '').size() > 0 && data.get('name', '').size() <= 200)
        && (data.get('hostCode', '') is string && data.get('hostCode', '').size() > 0 && data.get('hostCode', '').size() <= 64)
        && (data.get('hostName', null) == null || data.hostName is string)
        && (data.get('uniqueCode', '') is string && data.get('uniqueCode', '').size() > 0 && data.get('uniqueCode', '').size() <= 64)
        && (data.get('category', null) == null || data.category is string)
        && (data.get('genre', null) == null || data.genre is string)
        && (data.get('currentMovieUrl', '') is string && data.get('currentMovieUrl', '').size() <= 2000)
        && (data.get('currentMovieTitle', null) == null || data.currentMovieTitle is string)
        && (data.get('currentMovieImage', null) == null || data.currentMovieImage is string)
        && (data.get('isPlaying', null) == null || data.isPlaying is bool)
        && ((data.get('currentTime', 0) is int) || (data.get('currentTime', 0) is float))
        && data.get('currentTime', 0) >= 0
        && (data.get('activeUsers', null) == null || data.activeUsers is list)
        && (data.get('createdAt', null) == null || data.createdAt is string || data.createdAt is timestamp)
        && (data.get('updatedAt', null) == null || data.updatedAt is string || data.updatedAt is timestamp);
    }

    function isValidFriendsRoomMessage(data) {
      return (data.get('sender', '') is string && data.get('sender', '').size() > 0 && data.get('sender', '').size() <= 100)
        && (data.get('senderCode', '') is string && data.get('senderCode', '').size() > 0 && data.get('senderCode', '').size() <= 64)
        && (data.get('text', '') is string && data.get('text', '').size() > 0 && data.get('text', '').size() <= 2000)
        && (data.get('timestamp', null) == null || data.timestamp is string)
        && (data.get('createdAt', null) == null || data.createdAt is timestamp);
    }

    match /friends_rooms/{roomId} {
      allow read: if true;
      allow create, update: if isValidFriendsRoom(incoming());
      allow delete: if roomId != '_meta';

      match /messages/{messageId} {
        allow read: if true;
        allow create: if isValidFriendsRoomMessage(incoming());
        allow update, delete: if false;
      }
    }

    // --- Collection Group Rules ---
    match /{path=**}/messages/{messageId} {
      allow read: if isAdmin();
    }
  }
}
