# scripts/.env.local.example
# Copy this file to scripts/.env.local and fill in ONE of the two options.
# .env.local is gitignored and will NOT be committed.

# Option A: Deploy Hook (easiest — get from Render dashboard)
# Go to: https://dashboard.render.com → cinemachat-server → Settings → Build & Deploy → Deploy Hook
# RENDER_DEPLOY_HOOK=https://api.render.com/deploy?key=YOUR_HOOK_KEY

# Option B: Render API (get from https://dashboard.render.com/account#api-keys)
# RENDER_API_KEY=rnd_xxxxxxxxxxxxx
# RENDER_SERVICE_ID=srv-xxxxxxxxxxxxx
