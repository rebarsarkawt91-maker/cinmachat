# Agora API Configuration
# Get your App ID from https://console.agora.io/
VITE_AGORA_APP_ID=

# Firebase Configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=auth.cinamachat.com
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=

# Server-side Firebase Admin SDK — used by the profile persistence API to
# cryptographically verify Firebase ID tokens (Bearer <idToken>) instead of
# parsing the JWT manually. Provide ONE of the following credential sources:
#   1. FIREBASE_SERVICE_ACCOUNT=<service-account JSON as a single-line string>
#   2. GOOGLE_APPLICATION_CREDENTIALS=<path to service-account JSON file>
#   3. FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY + FIREBASE_PROJECT_ID
# For LOCAL DEVELOPMENT ONLY, you may use the Firebase Auth Emulator instead:
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
VITE_API_URL=
VITE_BACKEND_URL=

# Gemini API
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=

# Google Search Console Integration (SEO dashboard)
# Create a service account in the Google Cloud Console, download its JSON key,
# and grant it "full" permission in Google Search Console for your property.
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# GOOGLE_SEARCH_CONSOLE_SITE_URL=sc-domain:cinamachat.com

# Admin Master Bypass Key
ADMIN_SECRET_KEY=

# WhatsApp Configuration
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_GROUP_LINK=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_ADMIN_NUMBER=
